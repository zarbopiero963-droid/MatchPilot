[Unit]
Description=MatchPilot FPT liveness probe every 30 min (skips the 03:15-04:45 backup window)
[Timer]
OnCalendar=*-*-* 00..02,05..23:05,35:00 Europe/Rome
OnCalendar=*-*-* 03:05:00 Europe/Rome
OnCalendar=*-*-* 04:50:00 Europe/Rome
Persistent=false
Unit=matchpilot-fpt-liveness.service
[Install]
WantedBy=timers.target
