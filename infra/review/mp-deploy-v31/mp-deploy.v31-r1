#!/bin/bash
# mp-deploy <40-hex-sha> — MatchPilot deploy v3.1 (MP-VPS-GATE-V31-PREP-01, OFFLINE BUILD, NOT INSTALLED)
# = v3 (07dbed21) + PR #181 §8.4 (approved, main-tip x2) + single verifier + root-only lock + integrity checks.
# Token: GitHub Actions OIDC JWT on STDIN (never argv).
# Exit: 0 OK/ALREADY; 2 usage; 75 lock (nothing consumed); 1 build/other failures; 77 AUTHZ refused; 78 FROZEN;
#       79 TIP (stale/unverifiable main); 80 INTEGRITY.
# Config (root 0600, fail-closed): /etc/mp-deploy/authz.conf
#   MODE=enforce|report  FREEZE=1|0  VERIFIER_SHA256= GUARD_SHA256= GATE_SHA256= HOOK_SHA256= WORKFLOW_BLOB_SHA= SELF_SHA256=
#   missing/unsafe/invalid => MODE=enforce FREEZE=1. MODE=report requires FREEZE=1 (report never deploys a new SHA).
# Semantics:
#   FREEZE=1 + enforce : SHA != deployed -> 78 immediately (before network, ledger, lock).
#   FREEZE=1 + report  : SHA != deployed -> full evaluation (integrity, verify, lock, consume, approved, main-tip),
#                        each result logged, then 78. Never builds, never switches. The token IS consumed (R6 provable).
#   FREEZE=0 + enforce : deploy only if every step passes; main-tip re-checked just before the release switch.
#   SHA == deployed    : ALREADY_DEPLOYED (health) or FROZEN under freeze; never rebuilds under freeze.
set -uo pipefail
umask 077
if [ -n "${SUDO_USER:-}${SUDO_UID:-}${SUDO_COMMAND:-}" ]; then
  for v in $(compgen -e | grep -E '^MP_'); do unset "$v"; done
fi
TESTMODE=0
if [ "${MP_TEST_STUB:-0}" = 1 ] && [ -z "${SUDO_USER:-}${SUDO_UID:-}${SUDO_COMMAND:-}" ]; then TESTMODE=1; fi
OWNER_UID=0; [ "$TESTMODE" = 1 ] && OWNER_UID=$(id -u)
TOKEN=""
if [ ! -t 0 ]; then TOKEN=$(timeout 5 head -c 16385 2>/dev/null | tr -d ' \r\n\t' || true); fi

REPO="${MP_REPO:-https://github.com/zarbopiero963-droid/MatchPilot}"
DEP="${MP_DEPLOY_ROOT:-/srv/mp-deploy}"
REL="$DEP/releases"
CUR="$DEP/current"
BUILD_ROOT="${MP_BUILD_ROOT:-/srv/mp-build}"
STATE="${MP_STATE:-/var/lib/mp-deploy}"
LOGD="${MP_LOGDIR:-/var/log/mp-deploy}"
LOG="$LOGD/deploy.log"
# V31-06: lock inside a root-only 0700 directory: the runner cannot open (hence cannot flock) it.
LOCKDIR="${MP_LOCKDIR:-/run/mp-deploy}"
LOCK="$LOCKDIR/deploy.lock"
KEEP=5
BUILD_USER="${MP_BUILD_USER:-mpbuild}"
TESTENV="${MP_TESTENV:-/etc/mp-deploy/test.env}"
SHA="${1:-}"
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "usage: mp-deploy <40-hex sha>" >&2; exit 2; }

require_root_dir() {
  local d="$1"
  if [ -L "$d" ]; then echo "FAIL_UNSAFE_PATH symlink $d" >&2; exit 3; fi
  if [ ! -d "$d" ]; then install -d -m 755 "$d"; fi
  if [ -L "$d" ] || [ "$(stat -c %u "$d")" != "$OWNER_UID" ]; then echo "FAIL_UNSAFE_OWNER $d" >&2; exit 3; fi
  local rp; rp=$(realpath -e "$d") || { echo "FAIL_REALPATH $d" >&2; exit 3; }
  case "$rp" in
    "$DEP"|"$DEP"/*|"$STATE"|"$STATE"/*|"$LOGD"|"$LOGD"/*|"$BUILD_ROOT"|"$BUILD_ROOT"/*|"$LOCKDIR") ;;
    /run/mp-deploy|/var/lib/mp-deploy|/var/lib/mp-deploy/*|/var/log/mp-deploy|/var/log/mp-deploy/*|/srv/mp-deploy|/srv/mp-deploy/*|/srv/mp-build|/srv/mp-build/*) ;;
    *) echo "FAIL_REALPATH_OUTSIDE $rp" >&2; exit 3 ;;
  esac
}

# ================= v3.1 configuration =================
GATEDIR="/usr/local/libexec/mp-gate"            # V31-01: the ONLY verifier location
AUTHZ_CONF="/etc/mp-deploy/authz.conf"
GUARD_CONF="/etc/mp-deploy/runner-guard.json"
HOOK="/usr/local/libexec/mp-runner-guard.sh"
RUNNER_ENV="/opt/actions-runner/.env"
SUDOERS_DIR="/etc/sudoers.d"
SELF="$(realpath -e "$0" 2>/dev/null || echo "$0")"
LEDGER="$STATE/authz-ledger"; OIDC_BASE="https://token.actions.githubusercontent.com"; CURLPROTO="=https"
ROOT_STOP="/"                                     # ancestor walk stops here (production: up to /)
NODE_PRE=()
if [ "$TESTMODE" = 1 ]; then
  GATEDIR="${MP_GATEDIR:-$GATEDIR}"; AUTHZ_CONF="${MP_AUTHZ_CONF:-$AUTHZ_CONF}"; GUARD_CONF="${MP_GUARD_CONF:-$GUARD_CONF}"
  HOOK="${MP_HOOK:-$HOOK}"; RUNNER_ENV="${MP_RUNNER_ENV:-$RUNNER_ENV}"; SUDOERS_DIR="${MP_SUDOERS_DIR:-$SUDOERS_DIR}"
  OIDC_BASE="${MP_OIDC_BASE:-$OIDC_BASE}"; CURLPROTO="=https,http"; ROOT_STOP="${MP_TEST_ROOT:-/}"
  [ -n "${MP_TEST_FETCH_MOCK:-}" ] && NODE_PRE=(--import "$MP_TEST_FETCH_MOCK")
fi
VERIFIER="$GATEDIR/deploy-authz.mjs"
alog(){ mkdir -p "$LOGD" 2>/dev/null; echo "$(date -Is) sha=$SHA authz $*" | tee -a "$LOGD/deploy.log" >&2; }
deny(){ alog "result=$1 ${2:-}"; exit "${3:-77}"; }
MODE=enforce; FREEZE=1; BADCONF=0
VSUM=""; GUARDSUM=""; GATESUM=""; HOOKSUM=""; WFBLOB=""; SELFSUM=""
hex64(){ [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
no_acl(){ local o; if command -v getfacl >/dev/null 2>&1; then o=$(getfacl -cps -- "$1" 2>/dev/null) || return 1; [ -z "$o" ] || return 1; fi
  o=$(ls -ld -- "$1" 2>/dev/null) || return 1; [ "${o:10:1}" != "+" ]; }   # '+' after mode bits = extended ACL
# root-owned (or test owner), regular, not symlink, no g/o write, no ACL; optional exact mode
safe_file(){ local f="$1" m="${2:-}"; [ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -c %u "$f")" = "$OWNER_UID" ] \
  && [ $(( 0$(stat -c %a "$f") & 022 )) -eq 0 ] && no_acl "$f" && { [ -z "$m" ] || [ "$(stat -c %a "$f")" = "$m" ]; }; }
# every ancestor directory: not symlink, root (or test owner), no g/o write, no ACL
safe_ancestors(){ local d; d=$(dirname "$1")
  while :; do
    [ -L "$d" ] && return 1
    [ "$(stat -c %u "$d")" = "$OWNER_UID" ] || [ "$(stat -c %u "$d")" = 0 ] || return 1
    [ $(( 0$(stat -c %a "$d") & 022 )) -eq 0 ] || return 1
    no_acl "$d" || return 1
    [ "$d" = "$ROOT_STOP" ] || [ "$d" = / ] && break
    d=$(dirname "$d")
  done; }
if safe_file "$AUTHZ_CONF" 600 && safe_ancestors "$AUTHZ_CONF"; then
  while IFS='=' read -r k v; do
    case "$k" in
      MODE) case "$v" in enforce|report) MODE="$v";; *) BADCONF=1;; esac;;
      FREEZE) case "$v" in 0|1) FREEZE="$v";; *) BADCONF=1;; esac;;
      VERIFIER_SHA256) hex64 "$v" && VSUM="$v" || BADCONF=1;;
      GUARD_SHA256) hex64 "$v" && GUARDSUM="$v" || BADCONF=1;;
      GATE_SHA256) hex64 "$v" && GATESUM="$v" || BADCONF=1;;
      HOOK_SHA256) hex64 "$v" && HOOKSUM="$v" || BADCONF=1;;
      SELF_SHA256) hex64 "$v" && SELFSUM="$v" || BADCONF=1;;
      WORKFLOW_BLOB_SHA) [[ "$v" =~ ^[0-9a-f]{40}$ ]] && WFBLOB="$v" || BADCONF=1;;
      ''|\#*) ;;
      *) BADCONF=1;;
    esac
  done < "$AUTHZ_CONF"
else
  alog "conf_missing_or_unsafe -> enforce+freeze"; BADCONF=1
fi
[ "$MODE" = report ] && [ "$FREEZE" != 1 ] && { alog "conf_invalid report_requires_freeze"; BADCONF=1; }
[ "$BADCONF" = 1 ] && { MODE=enforce; FREEZE=1; alog "conf_invalid_or_missing -> enforce+freeze"; }

# ================= V31-04: FREEZE first (enforce: before ANY network, ledger or lock) =================
CURRENT=$(cat "$STATE/deployed" 2>/dev/null || true)
EVAL_ONLY=0
if [ "$FREEZE" = 1 ] && [ "$SHA" != "$CURRENT" ]; then
  [ "$MODE" = enforce ] && deny FROZEN "current=${CURRENT:-none}" 78
  EVAL_ONLY=1    # report+freeze: evaluate, record, then 78 (no build, no switch)
fi
# report+freeze: refusals are logged and evaluation continues; the final answer is 78 anyway
step_fail(){ # $1 code $2 reason $3 exit
  if [ "$EVAL_ONLY" = 1 ]; then alog "eval $1=REFUSE $2"; EVAL_FAIL=1; else deny "$1" "$2" "$3"; fi; }
EVAL_FAIL=0

# ================= V31-07: integrity (before network) =================
INTEG=""
chk(){ local f="$1" sum="$2" mode="${3:-}"
  safe_file "$f" "$mode" || { INTEG+=" unsafe:$f"; return; }
  safe_ancestors "$f" || { INTEG+=" ancestors:$f"; return; }
  [ -n "$sum" ] && [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$sum" ] || INTEG+=" hash:$f"; }
chk "$VERIFIER" "$VSUM" 644
chk "$GATEDIR/runner-job-guard.mjs" "$GUARDSUM" 644
chk "$GATEDIR/deploy-gate.mjs" "$GATESUM" 644
chk "$HOOK" "$HOOKSUM" 755
[ "$TESTMODE" = 1 ] && [ "${MP_TEST_SKIP_SELF:-0}" = 1 ] || chk "$SELF" "$SELFSUM" 755
if [ -d "$GATEDIR" ] && [ ! -L "$GATEDIR" ] && [ "$(stat -c %u "$GATEDIR")" = "$OWNER_UID" ] && [ "$(stat -c %a "$GATEDIR")" = 755 ] && no_acl "$GATEDIR"; then :; else INTEG+=" unsafe:$GATEDIR"; fi
# no other copy of the verifier is used (NB-E): the legacy path must be gone
[ -e /usr/local/libexec/mp-deploy-authz.mjs ] && [ "$TESTMODE" != 1 ] && INTEG+=" legacy_verifier_present"
# workflow pin (NB-F): guard config must pin exactly WORKFLOW_BLOB_SHA
if safe_file "$GUARD_CONF" 644 && safe_ancestors "$GUARD_CONF"; then
  PIN=$(timeout 5 node -e 'const c=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));const k=Object.keys(c);if(k.length!==1||typeof c.workflow_blob_sha!=="string")process.exit(1);process.stdout.write(c.workflow_blob_sha)' "$GUARD_CONF" 2>/dev/null) || PIN=""
  [ -n "$WFBLOB" ] && [ "$PIN" = "$WFBLOB" ] || INTEG+=" workflow_pin"
else INTEG+=" unsafe:$GUARD_CONF"; fi
# runner env: root:<runner group> 0640, hook line exactly ours
if [ -f "$RUNNER_ENV" ] && [ ! -L "$RUNNER_ENV" ] && [ "$(stat -c %u "$RUNNER_ENV")" = "$OWNER_UID" ] && [ "$(stat -c %a "$RUNNER_ENV")" = 640 ] \
   && [ "$(grep -c '^ACTIONS_RUNNER_HOOK_JOB_STARTED=' "$RUNNER_ENV")" = 1 ] && grep -qx "ACTIONS_RUNNER_HOOK_JOB_STARTED=$HOOK" "$RUNNER_ENV"; then :; else INTEG+=" runner_env"; fi
# sudo (read-only): ghrunner may run only mp-deploy; files root 0440
for f in "$SUDOERS_DIR"/*; do [ -e "$f" ] || continue; safe_file "$f" 440 || INTEG+=" unsafe_sudoers:$(basename "$f")"; done
G=$(grep -hE '^[[:space:]]*ghrunner[[:space:]]' "$SUDOERS_DIR"/* 2>/dev/null | sed 's/[[:space:]]\+/ /g;s/ $//')
[ "$G" = "ghrunner ALL=(root) NOPASSWD: /usr/local/sbin/mp-deploy" ] || INTEG+=" sudo_ghrunner"
if [ -n "$INTEG" ]; then step_fail INTEGRITY "${INTEG# }" 80; [ "$EVAL_ONLY" = 1 ] && deny FROZEN "after_eval integrity_failed current=${CURRENT:-none}" 78; fi

AZ_OK=0; AZ_WHY=""; AZ_OUT=""
TMPD=$(mktemp -d /tmp/mp-authz.XXXXXX) || deny AUTHZ_ERROR "mktemp"
trap 'rm -rf "$TMPD"' EXIT
vnode(){ timeout "${VNODE_TIMEOUT:-25}" node "${NODE_PRE[@]}" "$VERIFIER" "$@"; }
authz_verify(){ # $1 = verify|consume ; sets AZ_OK / AZ_WHY / AZ_OUT
  AZ_OK=0; AZ_OUT=""
  [ -n "$TOKEN" ] || { AZ_WHY="AUTHZ_NO_TOKEN"; return; }
  [ -d "$LEDGER" ] && [ ! -L "$LEDGER" ] && [ "$(stat -c %u "$LEDGER")" = "$OWNER_UID" ] && [ "$(stat -c %a "$LEDGER")" = 700 ] || { AZ_WHY="AUTHZ_LEDGER_UNSAFE"; return; }
  # verifier re-hashed right before each use (TOCTOU window limited to root-only paths)
  [ "$(sha256sum "$VERIFIER" | cut -d' ' -f1)" = "$VSUM" ] || { AZ_WHY="AUTHZ_VERIFIER_HASH"; return; }
  if [ ! -s "$TMPD/jwks.json" ]; then
    curl -fsS --proto "$CURLPROTO" --max-time 10 --max-filesize 65536 -o "$TMPD/oidc.json" "$OIDC_BASE/.well-known/openid-configuration" 2>/dev/null || { AZ_WHY="AUTHZ_JWKS_UNAVAILABLE oidc-config"; return; }
    JU=$(timeout 10 node -e 'const c=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));const b=process.argv[2];if(c.issuer!=="https://token.actions.githubusercontent.com"||typeof c.jwks_uri!=="string"||!c.jwks_uri.startsWith(b+"/"))process.exit(1);process.stdout.write(c.jwks_uri)' "$TMPD/oidc.json" "$OIDC_BASE" 2>/dev/null) || { AZ_WHY="AUTHZ_JWKS_UNEXPECTED oidc-config"; return; }
    curl -fsS --proto "$CURLPROTO" --max-time 10 --max-filesize 65536 -o "$TMPD/jwks.json" "$JU" 2>/dev/null || { rm -f "$TMPD/jwks.json"; AZ_WHY="AUTHZ_JWKS_UNAVAILABLE jwks"; return; }
  fi
  local rc
  AZ_OUT=$(printf '%s' "$TOKEN" | vnode "$1" --sha "$SHA" --jwks "$TMPD/jwks.json" --ledger "$LEDGER" 2>/dev/null); rc=$?
  if [ "$rc" = 0 ] && printf '%s' "$AZ_OUT" | grep -q '"result":"ACCEPT"'; then AZ_OK=1; AZ_WHY="ACCEPT"
  else AZ_WHY="REFUSE rc=$rc $(printf '%s' "$AZ_OUT" | head -c 600)"; fi
}
# V31-02: owner approval of exactly the token's run_id/run_attempt
approved_check(){ local rid ratt out rc
  rid=$(printf '%s' "$AZ_OUT" | timeout 5 node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const r=JSON.parse(s).run;if(r&&/^[1-9][0-9]{0,19}$/.test(r.run_id)&&/^[1-9][0-9]{0,4}$/.test(r.run_attempt)){process.stdout.write(r.run_id+" "+r.run_attempt);return}}catch{}process.exit(1)})' 2>/dev/null) \
    || { echo "AUTHZ_RUN_IDENTITY_MISSING"; return 1; }
  ratt=${rid#* }; rid=${rid% *}
  out=$(vnode approved --run-id "$rid" --run-attempt "$ratt" </dev/null 2>/dev/null); rc=$?
  if [ "$rc" = 0 ] && printf '%s' "$out" | grep -q '"result":"ACCEPT"'; then echo "run=$rid attempt=$ratt"; return 0; fi
  echo "rc=$rc run=$rid attempt=$ratt $(printf '%s' "$out" | head -c 500)"; return 1; }
# V31-03: tip of main from two sources must equal SHA
tip_check(){ local out rc
  out=$(vnode main-tip --sha "$SHA" </dev/null 2>/dev/null); rc=$?
  if [ "$rc" = 0 ] && printf '%s' "$out" | grep -q '"result":"ACCEPT"'; then return 0; fi
  echo "rc=$rc $(printf '%s' "$out" | head -c 500)"; return 1; }

authz_verify verify
if [ "$AZ_OK" = 1 ]; then alog "verify=ACCEPT mode=$MODE freeze=$FREEZE eval_only=$EVAL_ONLY"
elif [ "$EVAL_ONLY" = 1 ] || [ "$MODE" = enforce ]; then step_fail AUTHZ_REFUSED "verify: $AZ_WHY" 77
fi
# report + SHA == current under freeze: v3 behaviour (log only, then ALREADY/FROZEN below)
[ "$AZ_OK" != 1 ] && [ "$MODE" = report ] && [ "$EVAL_ONLY" = 0 ] && alog "verify=REFUSE(report-only) $AZ_WHY"

require_root_dir "$DEP"
require_root_dir "$REL"
require_root_dir "$STATE"
require_root_dir "$LOGD"
chmod 750 "$LOGD"
if [ ! -d "$BUILD_ROOT" ]; then install -d -o "$BUILD_USER" -g "$BUILD_USER" -m 700 "$BUILD_ROOT"; fi
if [ "$(stat -c %U "$BUILD_ROOT")" != "$BUILD_USER" ]; then echo "FAIL_BUILD_OWNER" >&2; exit 3; fi

# V31-06: root-only lock directory
if [ ! -d "$LOCKDIR" ]; then install -d -m 700 "$LOCKDIR"; fi
{ [ ! -L "$LOCKDIR" ] && [ "$(stat -c %u "$LOCKDIR")" = "$OWNER_UID" ] && [ "$(stat -c %a "$LOCKDIR")" = 700 ]; } || deny LOCK_UNSAFE "$LOCKDIR" 80
exec 9>"$LOCK"
flock -n 9 || { echo "another deploy running" >&2; exit 75; }

# ================= under the lock: consume, approved, main-tip #1 =================
if [ "$MODE" = enforce ] || [ "$EVAL_ONLY" = 1 ]; then
  if [ "$AZ_OK" = 1 ]; then
    authz_verify consume
    if [ "$AZ_OK" = 1 ]; then alog "consume=OK"; else step_fail AUTHZ_REFUSED "consume: $AZ_WHY" 77; fi
  fi
  if [ "$AZ_OK" = 1 ]; then
    if W=$(approved_check); then alog "approved=OK $W"; else step_fail AUTHZ_REFUSED "approved: $W" 77; fi
  else
    [ "$EVAL_ONLY" = 1 ] && alog "eval approved=SKIPPED (no accepted token)"
  fi
  if W=$(tip_check); then alog "main_tip_1=OK"; else step_fail TIP_REFUSED "main_tip_1: $W" 79; fi
fi
if [ "$EVAL_ONLY" = 1 ]; then deny FROZEN "after_eval eval_fail=$EVAL_FAIL current=${CURRENT:-none} (no build, no switch)" 78; fi
if [ "$TESTMODE" = 1 ] && [ "${MP_TEST_FULL_STUB:-1}" = 1 ]; then
  sleep "${MP_TEST_HOLD:-0}"
  if [ "$MODE" = enforce ]; then W=$(tip_check) || deny TIP_REFUSED "main_tip_2: $W" 79; alog "main_tip_2=OK"; fi
  alog "result=STUB_SWITCH_OK (test mode: build/switch stubbed)"; exit 0
fi

T0=$(date +%s)
log(){ echo "$(date -Is) sha=$SHA $*" | tee -a "$LOG"; }
finish(){ log "result=$1 total_s=$(( $(date +%s)-T0 )) ${2:-}"; case "$1" in FAIL_TESTS|FAIL_BUILD|BLOCKED_MIGRATION|BLOCKED_MIGRATION_MODIFIED) echo "$SHA $1 $(date -Is)" >> "$STATE/failed";; esac; exit "${3:-1}"; }

# health: only used when not skipped
health(){
  [ "${MP_SKIP_HEALTH:-0}" = 1 ] && return 0
  local i c
  for i in $(seq 1 30); do
    c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:3000/ || true)
    [ "$c" = 200 ] && return 0
    sleep 2
  done
  return 1
}

PREV=""
if [ -L "$CUR" ] || [ -e "$CUR" ]; then
  PREV=$(readlink -f "$CUR" 2>/dev/null || true)
  if [ -n "$PREV" ]; then
    case "$(realpath -e "$PREV" 2>/dev/null || true)" in
      "$REL"/*) ;;
      *) finish FAIL_UNSAFE_CURRENT "prev=$PREV" 3 ;;
    esac
  fi
fi
[ "$PREV" = "$REL/$SHA" ] && health && finish ALREADY_DEPLOYED "" 0
[ "$FREEZE" = 1 ] && finish FROZEN "same sha not healthy-deployed; no rebuild under freeze" 78
log "start prev=$PREV"

CACHE="$BUILD_ROOT/repo.git"
if [ ! -d "$CACHE" ]; then
  runuser -u "$BUILD_USER" -- git init -q --bare "$CACHE"
fi
t=$(date +%s)
runuser -u "$BUILD_USER" -- git -C "$CACHE" fetch -q --no-tags "$REPO" "+refs/heads/main:refs/heads/main" || finish FAIL_FETCH "" 1
runuser -u "$BUILD_USER" -- git -C "$CACHE" merge-base --is-ancestor "$SHA" refs/heads/main 2>/dev/null || finish FAIL_NOT_ON_MAIN "" 1

# Forward-only: new SHA must be descendant of currently deployed (unless root one-shot rollback marker)
LAST=$(cat "$STATE/deployed" 2>/dev/null || true)
if [ -n "$LAST" ] && [ "$LAST" != "$SHA" ]; then
  if ! runuser -u "$BUILD_USER" -- git -C "$CACHE" merge-base --is-ancestor "$LAST" "$SHA" 2>/dev/null; then
    M="$STATE/allow-rollback-$SHA"
    if [ -f "$M" ] && [ ! -L "$M" ] && [ "$(stat -c %u "$M")" = 0 ]; then
      rm -f "$M"
      log "rollback_marker_consumed sha=$SHA"
    else
      finish FAIL_NOT_MONOTONIC "last=$LAST" 1
    fi
  fi
fi

W="$BUILD_ROOT/$SHA"
# remove previous worktree as build user (their dir)
runuser -u "$BUILD_USER" -- rm -rf "$W"
{ runuser -u "$BUILD_USER" -- git clone -q --no-checkout "$CACHE" "$W" \
  && runuser -u "$BUILD_USER" -- git -C "$W" checkout -q --detach "$SHA"; } || finish FAIL_FETCH "" 1
log "fetched s=$(( $(date +%s)-t ))"

# migration guard (name-based, same as v1) + content ledger if present
LED="$STATE/migrations.sha256"
if [ -f "$LED" ] && [ ! -L "$LED" ] && [ "$(stat -c %u "$LED")" = 0 ]; then
  while read -r h f; do
    [ -z "${f:-}" ] && continue
    n=$(runuser -u "$BUILD_USER" -- sha256sum "$W/migrations/$f" 2>/dev/null | awk '{print $1}')
    [ "$n" = "$h" ] || { runuser -u "$BUILD_USER" -- rm -rf "$W"; finish BLOCKED_MIGRATION_MODIFIED "file=$f" 1; }
  done < "$LED"
fi
if [ -n "$PREV" ] && [ -d "$PREV/migrations" ] && [ -d "$W/migrations" ]; then
  NEW=$(comm -13 <(ls "$PREV/migrations" | sort) <(runuser -u "$BUILD_USER" -- ls "$W/migrations" | sort) | tr '\n' ' ')
  if [ -n "${NEW// }" ] && [ ! -e "$STATE/allow-migrations-$SHA" ]; then
    runuser -u "$BUILD_USER" -- rm -rf "$W"
    finish BLOCKED_MIGRATION "new_migrations=[$NEW]" 1
  fi
fi

# --- npm ci (network OK, FS sandbox) ---
t=$(date +%s)
INACC=(
  -p InaccessiblePaths=/srv/matchpilot/app.env
  -p InaccessiblePaths=/srv/matchpilot/.dbenv
  -p InaccessiblePaths=/srv/matchpilot/backups
  -p InaccessiblePaths=/srv/matchpilot/archives
  -p InaccessiblePaths=/srv/matchpilot/evidence
  -p InaccessiblePaths=/root
  -p InaccessiblePaths=/etc/mp-deploy
)
if ! systemd-run --wait --pipe --collect --uid="$BUILD_USER" --gid="$BUILD_USER"   -p PrivateTmp=yes -p NoNewPrivileges=yes -p ProtectHome=yes -p ProtectSystem=strict   -p ReadWritePaths="$BUILD_ROOT"   "${INACC[@]}"   -p Environment=HOME="$BUILD_ROOT"   --working-directory="$W"   -- /usr/bin/npm ci --no-audit --no-fund --loglevel=error >>"$LOG" 2>&1; then
  runuser -u "$BUILD_USER" -- rm -rf "$W"
  finish FAIL_BUILD "" 1
fi
log "npm_ci s=$(( $(date +%s)-t ))"

# --- tests (localhost only for PG) ---
t=$(date +%s)
TAP="$LOGD/test-$SHA.tap"
if [ ! -f "$TESTENV" ] || [ -L "$TESTENV" ] || [ "$(stat -c %u "$TESTENV")" != 0 ]; then
  finish FAIL_TESTENV "missing_or_unsafe $TESTENV" 1
fi
# Password never sourced into this shell; systemd injects EnvironmentFile into the sandboxed unit only.
# Note: /etc/mp-deploy is inaccessible to the unit process; EnvironmentFile is loaded by PID1.

set +e
systemd-run --wait --pipe --collect --uid="$BUILD_USER" --gid="$BUILD_USER"   -p PrivateTmp=yes -p NoNewPrivileges=yes -p ProtectHome=yes -p ProtectSystem=strict   -p ReadWritePaths="$BUILD_ROOT"   "${INACC[@]}"   -p IPAddressDeny=any -p "IPAddressAllow=127.0.0.1 ::1"   -p EnvironmentFile="$TESTENV"   -p Environment=MATCHPILOT_RUNTIME_MODE=offline   -p Environment=MATCHPILOT_BACKGROUND_ENABLED=false   -p Environment=FUTPYTHON_CRON_ENABLED=false   -p Environment=DATA_WATCHDOG_ENABLED=false   -p Environment=HOME="$BUILD_ROOT"   --working-directory="$W"   -- /bin/bash -c 'npm run -s check && node --test --test-reporter=tap' >"$TAP" 2>&1
RC=$?
set +e
SUM=$(grep -E '^# (pass|fail|skipped)' "$TAP" | tr '
' ' ' || true)
log "tests rc=$RC s=$(( $(date +%s)-t )) $SUM"
if [ "$RC" -ne 0 ]; then
  runuser -u "$BUILD_USER" -- rm -rf "$W"
  finish FAIL_TESTS "tap=$TAP" 1
fi

# Copy into fresh ROOT-OWNED dir only (race mitigation: never write/chown under build-user trees).
# Stream from build user via tar; root extracts into empty root-owned $D.tmp; reject absolute
# symlinks and any symlink whose realpath escapes $D.tmp (relative ../ inside tree is OK).
D="$REL/$SHA"
rm -rf "$D.tmp"
install -d -o root -g root -m 755 "$D.tmp"
runuser -u "$BUILD_USER" -- tar -C "$W" --exclude=./.git -cf - . \
  | tar -C "$D.tmp" -xf - --no-same-owner --no-same-permissions \
  || { rm -rf "$D.tmp"; finish FAIL_COPY "" 1; }
while IFS= read -r -d '' link; do
  tgt=$(readlink "$link" || true)
  case "$tgt" in
    /*) rm -rf "$D.tmp"; finish FAIL_UNSAFE_LINK "absolute $link -> $tgt" 1 ;;
  esac
  res=$(realpath -e "$link" 2>/dev/null || true)
  case "$res" in
    "$D.tmp"|"$D.tmp"/*) ;;
    *) rm -rf "$D.tmp"; finish FAIL_UNSAFE_LINK "escapes $link -> $res (tgt=$tgt)" 1 ;;
  esac
done < <(find "$D.tmp" -type l -print0)
chown -R -h root:root "$D.tmp"
chmod -R a-s,go-w "$D.tmp"
rm -rf "$D"
mv -T "$D.tmp" "$D"

# V31-03: second tip check immediately before the atomic switch (enforce only; report never reaches here)
if [ "$MODE" = enforce ]; then
  if W=$(tip_check); then log "main_tip_2=OK"; else finish TIP_REFUSED "main_tip_2: $W" 79; fi
fi
# Atomic switch
ln -sfn "$D" "$CUR.new" && mv -T "$CUR.new" "$CUR"

if [ "${MP_SKIP_RESTART:-0}" != 1 ]; then
  systemctl restart matchpilot-app.service
fi

if health; then
  echo "$SHA" > "$STATE/deployed"
  if [ -d "$D/migrations" ]; then
    ( cd "$D/migrations" && sha256sum * 2>/dev/null | awk '{print $1, $2}' > "$LED.new" && mv "$LED.new" "$LED" )       || log "warn=migration_ledger_failed"
  fi
  # keep last KEEP releases (root-owned listing only)
  ls -1dt "$REL"/*/ 2>/dev/null | sed 's#/$##' | grep -v -e "^$D\$" -e "^${PREV:-__none__}\$" | tail -n +$KEEP | while read -r old; do
    case "$old" in "$REL"/*) rm -rf "$old" ;; esac
  done
  # cleanup build worktree
  runuser -u "$BUILD_USER" -- rm -rf "$W"
  finish OK "health=200" 0
fi

log "health FAILED -> rollback to $PREV"
if [ -n "$PREV" ]; then
  ln -sfn "$PREV" "$CUR.new" && mv -T "$CUR.new" "$CUR"
  [ "${MP_SKIP_RESTART:-0}" != 1 ] && systemctl restart matchpilot-app.service
  health && R=ok || R=FAILED
else
  R=none
fi
echo "$SHA FAIL_HEALTH $(date -Is)" >> "$STATE/failed"
finish FAIL_HEALTH_ROLLED_BACK "rollback=$R" 1
